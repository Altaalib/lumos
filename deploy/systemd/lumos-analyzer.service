[Unit]
Description=Lumos — analyzer (анализ важности через LLM)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=lumos
WorkingDirectory=/opt/lumos
EnvironmentFile=/opt/lumos/.env
ExecStart=/opt/lumos/bin/analyzer
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
