# Собирать из корня репозитория:
#   docker build -f deploy/docker/Dockerfile.notifier -t lumos-notifier .
FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/notifier ./cmd/notifier

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/notifier ./notifier
ENTRYPOINT ["./notifier"]
