# --- Общее для всех трёх сервисов ---
DATABASE_URL=postgres://lumos:lumos@localhost:5432/lumos?sslmode=disable

# --- Reader (MTProto, gotd/td) ---
# APP_ID и APP_HASH берутся на https://my.telegram.org -> API development tools
TG_APP_ID=
TG_APP_HASH=
# Номер телефона аккаунта, под которым сервис читает каналы (с кодом страны, например +79991234567)
TG_PHONE=
# Пароль двухфакторной аутентификации — только если она включена на аккаунте, иначе оставить пустым
TG_PASSWORD=
# Публичные каналы через запятую, без @ или с ним — без разницы
TG_CHANNELS=
# Куда сохранять сессию MTProto после первого интерактивного логина
TG_SESSION_FILE=
READER_POLL_INTERVAL=2m

# --- Analyzer (LLM) ---
# Формат Chat Completions API (OpenAI-совместимый). Дефолт — сам OpenAI,
# но подходит любой провайдер с таким же форматом: OpenRouter, DeepSeek,
# локальный vLLM/Ollama и т.д. — для них меняются только эти три поля.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30s
CRITERIA_FILE=criteria.txt
ANALYZER_WORKERS=4
ANALYZER_BATCH_SIZE=20
ANALYZER_POLL_INTERVAL=30s
READER_INITIAL_LIMIT=5

# --- Notifier (Bot API) ---
# Токен бота — получить у @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID, куда слать уведомления — свой личный ID, узнать например у @userinfobot
TELEGRAM_CHAT_ID=
NOTIFIER_BATCH_SIZE=20
NOTIFIER_POLL_INTERVAL=15s
TG_FORWARD_GROUP=
TG_NOTIFIER_SESSION_FILE=